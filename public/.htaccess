# Agile Door — configuracao para hospedagem Apache (build estatico de out/).
#
# O build estatico nao aplica os cabecalhos definidos em next.config.ts, porque
# `headers()` so existe no modo servidor. A politica abaixo reproduz a mesma
# configuracao, para os dois modos se comportarem igual.
#
# Basta enviar o conteudo de out/ (incluindo este arquivo) para public_html.

Options -Indexes
ErrorDocument 404 /404.html

# ------------------------------------------------- endereco oficial e HTTPS
# O endereco oficial e https://www.agiledoor.com.br — e o que esta gravado no
# sitemap, no robots, nas tags de compartilhamento e nos QR codes dos
# panfletos. Sem a regra do www, o site responderia nos dois enderecos e o
# Google indexaria o mesmo conteudo duas vezes.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # sem www -> www, ja em https (um salto so). As excecoes deixam o pacote
  # continuar testavel em localhost e por IP.
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^[0-9.]+$
  RewriteCond %{HTTP_HOST} !^$
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ja com www, mas ainda em http
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------- cabecalhos de seguranca
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.facebook.com; font-src 'self'; connect-src 'self' https://www.facebook.com https://connect.facebook.net; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # HSTS so faz sentido servido sobre HTTPS
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
</IfModule>

# ---------------------------------------------------------------- compressao
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

# ------------------------------------------------------------------- cache
<IfModule mod_headers.c>
  # Arquivos de /_next/static levam hash no nome: podem ficar em cache longo
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imagens e PDFs sao substituidos pelo mesmo nome: cache curto e revalidacao
  <FilesMatch "\.(png|jpe?g|svg|webp|ico|pdf)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>
  # HTML sempre revalida, senao uma atualizacao do site demora a aparecer
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------- MIME types
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
